{
  "name": "functions",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.js --sourcemap --alias:@global-wallet/contracts=../packages/contracts/src/index.ts --external:firebase-admin --external:firebase-functions --external:@prisma/client --external:@prisma/client/runtime/library --external:fastify --external:@fastify/cookie --external:@fastify/cors --external:zod",
    "build:watch": "npm run build -- --watch",
    "postinstall": "if [ -f ../apps/api/prisma/schema.prisma ]; then mkdir -p prisma && cp ../apps/api/prisma/schema.prisma prisma/schema.prisma; fi; if [ -f prisma/schema.prisma ]; then prisma generate --schema prisma/schema.prisma; fi",
    "prisma:generate": "if [ -f ../apps/api/prisma/schema.prisma ]; then mkdir -p prisma && cp ../apps/api/prisma/schema.prisma prisma/schema.prisma; fi; prisma generate --schema prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^6.3.1",
    "fastify": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "prisma": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "esbuild": "^0.25.0",
    "firebase-functions-test": "^3.4.1",
    "typescript": "^5.7.3"
  },
  "private": true
}
